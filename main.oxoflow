# oxo-flow port of xuzhougeng/auto_sra_rnaseq_pipeline @ 923b9e9
# (default-parameters main execution path, Snakefile).
#
# Upstream: https://github.com/xuzhougeng/auto_sra_rnaseq_pipeline
#   (main HEAD, sha 923b9e98669a02d7b63ac8743e7ed960f3d0a86e)
# Default path (rule all): get_sra -> data_conversion_pair -> merge_R1/R2_data
#   -> data_clean_pair (fastp) -> align_and_count (STAR + --quantMode GeneCounts)
#   -> build_bam_index -> bamtobw (bigWig) -> combine_count -> DGE_analysis
#   (DESeq2 + ashr) -> onsuccess cleanup + optional email.
#
# Fidelity notes:
# - Per-SRR rules (get_sra, data_conversion_pair) become single-instance
#   script rules: oxo-flow fans rules out over {sample}/{pair_id} only, while
#   the upstream {sra} wildcard values come from the metadata TSV at load
#   time. The ported scripts iterate the same metadata rows and run the
#   identical commands (fasterq-dump per SRR); the upstream run.py
#   --resources limit_dump=2 cap is kept as a resource group on the
#   per-sample dump rules.
# - Upstream input functions (get_merged_input_data_R1/R2) and run: blocks
#   (get_sra, combine_count) read the metadata with pandas; the port moves
#   them to scripts/ with identical logic (scripts read {config.metadata}
#   directly). merge_R1/R2_data keeps the upstream `cat ... > out` command.
# - Sample fan-out: upstream derives samples from the metadata GSM column at
#   load time; the port declares them in [[sample_groups]] — keep in sync
#   with the GSM column of {config.metadata} (see README "Usage").
# - DB_ID: upstream computes it as basename(metadata).replace(".txt", "");
#   the port takes it from [config] db_id (keep in sync with the metadata
#   file name; combine_count fails fast on a mismatch).
# - fastp_threads / star_threads config keys are baked into
#   [rules.resources] threads (upstream defaults 8 / 20) — oxo-flow
#   resource numbers are literals.
# - align_and_count memory escalation (mem_mb lambda: 10000 first attempt,
#   60000*(attempt-1) after) is not expressible — the port pins the
#   first-attempt value 10000 (--limitBAMsortRAM 10000000000, resources
#   memory "10G").
# - Snakemake workflow-level onsuccess (rmtree 02_read_align + email) is
#   attached to the final rule DGE_analysis as on_success; onerror email
#   has no oxo-flow equivalent (per-rule on_failure only) — not ported.
# - --restart-times 3 comes from the upstream batch runner run.py — runtime
#   orchestration, not ported (use `oxo-flow run --resume-failed`).
#
# Not ported (see README fidelity table): single-end rules
# (data_conversion_single, merge_data, data_clean_single — upstream routes
# per sample by the metadata 'paired' column; the port ships the paired-end
# path, and the upstream example dataset D21122 is all-PAIRED),
# Snakefile_ENCODE, run.py batch runner, bark/feishu notifications, slurm
# profile, scripts/update_json.py.

[workflow]
name = "oxo-flow-auto-sra-rnaseq-pipeline"
version = "1.0.0"
description = "SRA-powered RNA-seq from local .sra archives to differential expression: fasterq-dump, fastp trimming, STAR alignment with gene counts, bigWig signal tracks, merged count matrix, DESeq2 with ashr shrinkage — oxo-flow port of xuzhougeng/auto_sra_rnaseq_pipeline"
author = "oxo-flow-community"

[config]
# STAR index dir and GTF (upstream keys index / GTF).
index = "/data/reference/genome/GRCh38/STAR"
GTF = "/data/reference/genome/GRCh38/Homo_sapiens.GRCh38.95.sort.gtf"
# Metadata TSV (upstream key metadata). Columns:
#   Dataset GSE GSM gene method celline group group_name type platform SRR paired
# The repo default points at the bundled example dataset (upstream doc/D21122.txt).
metadata = "test/fixtures/metadata/D21122_6sample.txt"
# Directory holding pre-downloaded .sra files, layout <dir>/<SRR>/<SRR>.sra
# (upstream key sra_data_path).
sra_data_path = "sra"
# Separator joining multiple SRR runs per sample in the metadata SRR column.
srr_separator = ","
# DB_ID — upstream: basename(metadata).replace(".txt", "").
db_id = "D21122"
# Email notification (upstream onsuccess). Keep off unless SMTP is configured.
mail = false
sender = ""
sender_password = ""
mail_to = ""

[defaults]
threads = 1

# Sample source: the GSM column of the metadata file. Keep in sync with
# {config.metadata} — upstream derives this list from the metadata at load
# time; oxo-flow needs it declared (see README "Usage").
[[sample_groups]]
name = "cohort"
samples = [
    "GSM4156339", "GSM4156340", "GSM4156341",
    "GSM4156351", "GSM4156352", "GSM4156353",
]

# Upstream run.py caps concurrent merges at 2 (--resources limit_merge=2);
# each merge rule claims 1 unit (upstream resources: limit_merge = 1).
# Dumps are capped at 2 the same way (upstream limit_dump=2) — the
# per-sample dump rules would otherwise all run at once and the six
# uncompressed FASTQ sets (~27G per sample) coexist on disk, tripping
# fasterq-dump's disk-limit check on small volumes (live: v18).
[resource_groups]
limit_merge = { max = 2 }
limit_dump = { max = 2 }
# Serialized STAR: 3 concurrent x 20 threads oversubscribes a shared
# 64-core box and the STARs thrash each other (live observation).
limit_align = { max = 1 }

# ---------------------------------------------------------------------------
# SRA access and conversion
# ---------------------------------------------------------------------------

[[rules]]
name = "get_sra"
description = "Verify locally downloaded .sra files and symlink them into sra/<SRR>/<SRR>.sra (upstream get_sra run: block)"
input = ["{config.metadata}"]
output = []
script = "scripts/get_sra.py --metadata {config.metadata} --sra-data-path {config.sra_data_path} --separator {config.srr_separator}"
environment = { conda = "envs/count.yaml" }
localrule = true

[[rules]]
name = "sra_dump"
description = "Convert one sample's .sra archives to paired FASTQ with fasterq-dump (upstream data_conversion_pair; one rule per sample so the merge consumes and deletes the reads immediately — bundling all dumps in one rule made the whole uncompressed read set coexist on disk and tripped fasterq-dump's disk-limit check on small volumes)"
input = ["{config.metadata}"]
output = ["sra/{sample}.dumped"]
script = "scripts/dump_sra.py --metadata {config.metadata} --separator {config.srr_separator} --sample {sample}"
environment = { conda = "envs/download.yaml" }
depends_on = ["get_sra"]
# fasterq-dump on a full sample takes ~15-30 min; the bound catches
# stalls instead of letting them spin silently (see align_and_count).
time_limit = "1h"
localrule = true
# schedule the dumps before the merges (p20): the producers must start
# first so the interleaved consume-and-delete has something to consume
priority = 25

[rules.resources]
groups = { limit_dump = 1 }

[[rules]]
name = "merge_R1_data"
description = "Concatenate R1 FASTQ of all SRR runs of a sample (upstream merge_R1_data + get_merged_input_data_R1)"
input = ["{config.metadata}"]
output = ["00_raw_data/{sample}_R1.fq"]
temp_output = ["00_raw_data/{sample}_R1.fq"]
script = "scripts/merge_reads.py --metadata {config.metadata} --separator {config.srr_separator} --sample {sample} --read 1 --output {output[0]}"
environment = { conda = "envs/count.yaml" }
# The fastqs are discovered INSIDE the script via the metadata (no
# static input edge to sra_dump) — without this the merge schedules as
# soon as get_sra lands, holds limit_merge while polling 90 min, and
# the dumps starve behind it in the FIFO queue (live: 5400s waits,
# merge timeout failures). depends_on expands to all sra_dump
# instances, restoring the real producer->consumer order.
depends_on = ["get_sra", "sra_dump"]
localrule = true
priority = 20

[rules.resources]
groups = { limit_merge = 1 }

[[rules]]
name = "merge_R2_data"
description = "Concatenate R2 FASTQ of all SRR runs of a sample (upstream merge_R2_data + get_merged_input_data_R2)"
input = ["{config.metadata}"]
output = ["00_raw_data/{sample}_R2.fq"]
temp_output = ["00_raw_data/{sample}_R2.fq"]
script = "scripts/merge_reads.py --metadata {config.metadata} --separator {config.srr_separator} --sample {sample} --read 2 --output {output[0]}"
environment = { conda = "envs/count.yaml" }
depends_on = ["get_sra", "sra_dump"]
localrule = true
priority = 20

[rules.resources]
groups = { limit_merge = 1 }

[[rules]]
name = "data_clean_pair"
description = "Trim and filter paired reads with fastp (upstream data_clean_pair)"
input = ["00_raw_data/{sample}_R1.fq", "00_raw_data/{sample}_R2.fq"]
output = ["01_clean_data/{sample}_R1.fq", "01_clean_data/{sample}_R2.fq"]
temp_output = ["01_clean_data/{sample}_R1.fq", "01_clean_data/{sample}_R2.fq"]
log = "log/{sample}_fastp.log"
pre_exec = "mkdir -p log"
environment = { conda = "envs/preprocess.yaml" }
priority = 30

shell = """
fastp -w {threads} -i {input[0]} -I {input[1]} -o {output[0]} -O {output[1]} \\
	-j log/{sample}.json -h log/{sample}.html &> log/{sample}_fastp.log
"""

[rules.resources]
threads = 8  # upstream fastp_threads = 8

# ---------------------------------------------------------------------------
# Alignment and quantification
# ---------------------------------------------------------------------------

[[rules]]
name = "align_and_count"
description = "STAR alignment with gene counts (upstream align_and_count)"
input = ["01_clean_data/{sample}_R1.fq", "01_clean_data/{sample}_R2.fq"]
output = ["02_read_align/{sample}_Aligned.sortedByCoord.out.bam", "02_read_align/{sample}_ReadsPerGene.out.tab"]
temp_output = ["02_read_align/{sample}_Aligned.sortedByCoord.out.bam"]
log = "log/{sample}_Log.final.out"
benchmark = "benchmark/STAR/{sample}.tsv"
pre_exec = "mkdir -p log benchmark/STAR"
environment = { conda = "envs/align.yaml" }
# Wall-clock tripwire: a stalled STAR spins with no signal (live: 20h
# at ~2%). NOTE this is NOT stall detection — a healthy-but-slow run
# also dies at the bound; the engine's progress-based stall detection
# is the right long-term mechanism (filed upstream). 2h is ~2-4x the
# full-sample alignment on a free 20-thread machine.
time_limit = "2h"
priority = 40

# ONE align at a time: 3 concurrent STARs x 20 threads = 60/64 cores
# on a shared box, and they thrash each other plus the NFS BAM sort
# (live: the top CPU consumers with no forward progress). Serialized,
# each STAR gets its full thread claim and the box stays responsive.
[rules.resources]
groups = { limit_align = 1 }

shell = """
STAR \
	--genomeDir {config.index} \
	--runThreadN {threads} \
	--readFilesIn {input[0]} {input[1]} \
	--outFileNamePrefix 02_read_align/{sample}_ \
	--outSAMtype BAM SortedByCoordinate \
	--outBAMsortingThreadN 10 \
    --limitBAMsortRAM $(({params.mem_mb} * 1000000)) \
	--quantMode GeneCounts --sjdbGTFfile {config.GTF} \
	--outTmpKeep None && \
	mv 02_read_align/{sample}_Log.final.out log/{sample}_Log.final.out
"""

[rules.resources]
threads = 20  # upstream star_threads = 20
memory = "10G"  # upstream resources.mem_mb first-attempt value (10000)

[rules.params]
mem_mb = 10000

[[rules]]
name = "build_bam_index"
description = "Index BAM files with samtools (upstream build_bam_index)"
input = ["02_read_align/{sample}_Aligned.sortedByCoord.out.bam"]
output = ["02_read_align/{sample}_Aligned.sortedByCoord.out.bam.bai"]
temp_output = ["02_read_align/{sample}_Aligned.sortedByCoord.out.bam.bai"]
environment = { conda = "envs/align.yaml" }
priority = 40

shell = "samtools index -@ {threads} {input[0]}"

[rules.resources]
threads = 4

[[rules]]
name = "bamtobw"
description = "Generate BPM-normalized bigWig signal tracks with bamCoverage (upstream bamtobw)"
input = ["02_read_align/{sample}_Aligned.sortedByCoord.out.bam", "02_read_align/{sample}_Aligned.sortedByCoord.out.bam.bai"]
output = ["04_bigwig/{sample}.bw"]
environment = { conda = "envs/align.yaml" }
priority = 45

shell = """
bamCoverage -p {threads} \
	--binSize {params.bs} \
	--effectiveGenomeSize {params.gs} \
	--normalizeUsing {params.norm} \
	-b {input[0]} -o {output[0]}
"""

[rules.resources]
threads = 10

[rules.params]
bs = "50"
gs = "2913022398"
norm = "BPM"

# ---------------------------------------------------------------------------
# Count matrix and differential expression
# ---------------------------------------------------------------------------

[[rules]]
name = "combine_count"
description = "Merge per-sample ReadsPerGene tables into one count matrix (upstream combine_count run: block)"
input = []
expand_inputs = [
    { pattern = "02_read_align/{sample}_ReadsPerGene.out.tab", variables = { sample = "config.samples_list" } }
]
output = ["03_merged_counts/{config.db_id}.tsv"]
script = "scripts/combine_count.py --counts {input} --metadata {config.metadata} --output {output[0]}"
environment = { conda = "envs/count.yaml" }
priority = 35

[[rules]]
name = "DGE_analysis"
description = "DESeq2 differential analysis with ashr shrinkage (upstream DGE_analysis); on_success carries the upstream onsuccess cleanup (rmtree 02_read_align) and optional email"
input = ["03_merged_counts/{config.db_id}.tsv", "{config.metadata}"]
output = ["05_DGE_analysis/{config.db_id}.Rds"]
environment = { conda = "envs/deseq2.yaml" }
priority = 35

on_success = """
rm -rf 02_read_align
if [ "{config.mail}" = "true" ]; then
    python scripts/send_mail.py "snakemake run successful" "snakemake run successful
Following jobs fininished:
 {config.db_id}.Rds" {config.sender} {config.sender_password} {config.mail_to}
fi
"""

shell = "Rscript scripts/DESeq2_diff.R \"{input[0]}\" \"{input[1]}\" \"{output[0]}\""
